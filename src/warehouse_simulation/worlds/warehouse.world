<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="aws_industrial_warehouse">

    <!-- ============================================================== -->
    <!--  Physics — stable, no robot bouncing                           -->
    <!-- ============================================================== -->
    <physics name="default_physics" default="0" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver><type>quick</type><iters>50</iters><sor>1.3</sor></solver>
        <constraints>
          <cfm>0.0</cfm><erp>0.2</erp>
          <contact_max_correcting_vel>2.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>1</shadows>
      <grid>false</grid>
    </scene>

    <!-- Top-down bird's-eye: all 4 robots visible on launch -->
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>0 0 50 0 1.5707963 0</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

    <!-- ============================================================== -->
    <!--  Lighting — overhead industrial lamps                          -->
    <!-- ============================================================== -->
    <light name="sun" type="directional">
      <cast_shadows>0</cast_shadows>
      <pose>0 0 20 0 0 0</pose>
      <diffuse>0.4 0.4 0.4 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>0.1 0.1 -1</direction>
    </light>

    <light name="lamp_A1" type="point"><pose>-16 -8 7 0 0 0</pose><diffuse>0.9 0.9 0.88 1</diffuse><specular>0.2 0.2 0.2 1</specular><attenuation><range>22</range><linear>0.04</linear><constant>0.1</constant><quadratic>0.003</quadratic></attenuation><cast_shadows>0</cast_shadows></light>
    <light name="lamp_A2" type="point"><pose>-16   0 7 0 0 0</pose><diffuse>0.9 0.9 0.88 1</diffuse><specular>0.2 0.2 0.2 1</specular><attenuation><range>22</range><linear>0.04</linear><constant>0.1</constant><quadratic>0.003</quadratic></attenuation><cast_shadows>0</cast_shadows></light>
    <light name="lamp_A3" type="point"><pose>-16   8 7 0 0 0</pose><diffuse>0.9 0.9 0.88 1</diffuse><specular>0.2 0.2 0.2 1</specular><attenuation><range>22</range><linear>0.04</linear><constant>0.1</constant><quadratic>0.003</quadratic></attenuation><cast_shadows>0</cast_shadows></light>
    <light name="lamp_B1" type="point"><pose>  -4 -8 7 0 0 0</pose><diffuse>0.9 0.9 0.88 1</diffuse><specular>0.2 0.2 0.2 1</specular><attenuation><range>22</range><linear>0.04</linear><constant>0.1</constant><quadratic>0.003</quadratic></attenuation><cast_shadows>0</cast_shadows></light>
    <light name="lamp_B2" type="point"><pose>  -4   0 7 0 0 0</pose><diffuse>0.9 0.9 0.88 1</diffuse><specular>0.2 0.2 0.2 1</specular><attenuation><range>22</range><linear>0.04</linear><constant>0.1</constant><quadratic>0.003</quadratic></attenuation><cast_shadows>0</cast_shadows></light>
    <light name="lamp_B3" type="point"><pose>  -4   8 7 0 0 0</pose><diffuse>0.9 0.9 0.88 1</diffuse><specular>0.2 0.2 0.2 1</specular><attenuation><range>22</range><linear>0.04</linear><constant>0.1</constant><quadratic>0.003</quadratic></attenuation><cast_shadows>0</cast_shadows></light>
    <light name="lamp_C1" type="point"><pose>  8  -8 7 0 0 0</pose><diffuse>0.9 0.9 0.88 1</diffuse><specular>0.2 0.2 0.2 1</specular><attenuation><range>22</range><linear>0.04</linear><constant>0.1</constant><quadratic>0.003</quadratic></attenuation><cast_shadows>0</cast_shadows></light>
    <light name="lamp_C2" type="point"><pose>  8    0 7 0 0 0</pose><diffuse>0.9 0.9 0.88 1</diffuse><specular>0.2 0.2 0.2 1</specular><attenuation><range>22</range><linear>0.04</linear><constant>0.1</constant><quadratic>0.003</quadratic></attenuation><cast_shadows>0</cast_shadows></light>
    <light name="lamp_C3" type="point"><pose>  8    8 7 0 0 0</pose><diffuse>0.9 0.9 0.88 1</diffuse><specular>0.2 0.2 0.2 1</specular><attenuation><range>22</range><linear>0.04</linear><constant>0.1</constant><quadratic>0.003</quadratic></attenuation><cast_shadows>0</cast_shadows></light>
    <light name="lamp_D1" type="point"><pose>  20 -8 7 0 0 0</pose><diffuse>0.9 0.9 0.88 1</diffuse><specular>0.2 0.2 0.2 1</specular><attenuation><range>22</range><linear>0.04</linear><constant>0.1</constant><quadratic>0.003</quadratic></attenuation><cast_shadows>0</cast_shadows></light>
    <light name="lamp_D2" type="point"><pose>  20   0 7 0 0 0</pose><diffuse>0.9 0.9 0.88 1</diffuse><specular>0.2 0.2 0.2 1</specular><attenuation><range>22</range><linear>0.04</linear><constant>0.1</constant><quadratic>0.003</quadratic></attenuation><cast_shadows>0</cast_shadows></light>
    <light name="lamp_D3" type="point"><pose>  20   8 7 0 0 0</pose><diffuse>0.9 0.9 0.88 1</diffuse><specular>0.2 0.2 0.2 1</specular><attenuation><range>22</range><linear>0.04</linear><constant>0.1</constant><quadratic>0.003</quadratic></attenuation><cast_shadows>0</cast_shadows></light>

    <!-- ============================================================== -->
    <!--  Ground plane — light warehouse concrete                       -->
    <!-- ============================================================== -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>60 40</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><plane><normal>0 0 1</normal><size>60 40</size></plane></geometry>
          <material>
            <ambient>0.72 0.72 0.70 1</ambient>
            <diffuse>0.78 0.78 0.76 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================================================== -->
    <!--  Exterior walls — white industrial                             -->
    <!-- ============================================================== -->
    <model name="wall_north"><static>true</static><pose>0 18 4 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>56 0.3 8</size></box></geometry></collision><visual name="v"><geometry><box><size>56 0.3 8</size></box></geometry><material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.90 0.90 0.90 1</diffuse></material></visual></link></model>
    <model name="wall_south"><static>true</static><pose>0 -18 4 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>56 0.3 8</size></box></geometry></collision><visual name="v"><geometry><box><size>56 0.3 8</size></box></geometry><material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.90 0.90 0.90 1</diffuse></material></visual></link></model>
    <model name="wall_west"><static>true</static><pose>-28 0 4 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>0.3 36 8</size></box></geometry></collision><visual name="v"><geometry><box><size>0.3 36 8</size></box></geometry><material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.90 0.90 0.90 1</diffuse></material></visual></link></model>
    <model name="wall_east_north"><static>true</static><pose>28 13 4 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>0.3 10 8</size></box></geometry></collision><visual name="v"><geometry><box><size>0.3 10 8</size></box></geometry><material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.90 0.90 0.90 1</diffuse></material></visual></link></model>
    <model name="wall_east_south"><static>true</static><pose>28 -13 4 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>0.3 10 8</size></box></geometry></collision><visual name="v"><geometry><box><size>0.3 10 8</size></box></geometry><material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.90 0.90 0.90 1</diffuse></material></visual></link></model>
    <model name="wall_east_header"><static>true</static><pose>28 0 7 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>0.3 12 2</size></box></geometry></collision><visual name="v"><geometry><box><size>0.3 12 2</size></box></geometry><material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.90 0.90 0.90 1</diffuse></material></visual></link></model>

    <!-- ============================================================== -->
    <!--  PALLET RACKING — North bank: y = 11.5, 5 units at x centres  -->
    <!--  x = -20, -13, -6, 1, 8                                       -->
    <!--  Each unit: 6 m wide × 1 m deep × 2.5 m tall, 3 levels        -->
    <!--  Posts: dark steel. Decks: yellow. Boxes: cardboard brown.     -->
    <!--  Navigation zone y = -10 to +10 is fully CLEAR.               -->
    <!--  Robot homes (-8,±8) and inspection pts (y=0) are unobstructed -->
    <!-- ============================================================== -->

    <!-- Shelf unit N1 — x=-20, y=+11.5 -->
    <model name="shelf_N1">
      <static>true</static>
      <pose>-20 11.5 0 0 0 0</pose>
      <!-- Posts -->
      <link name="pFL"><pose>-2.8 -0.45 1.25 0 0 0</pose><collision name="c"><geometry><box><size>0.08 0.08 2.5</size></box></geometry></collision><visual name="v"><geometry><box><size>0.08 0.08 2.5</size></box></geometry><material><ambient>0.12 0.12 0.12 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material></visual></link>
      <link name="pFR"><pose> 2.8 -0.45 1.25 0 0 0</pose><collision name="c"><geometry><box><size>0.08 0.08 2.5</size></box></geometry></collision><visual name="v"><geometry><box><size>0.08 0.08 2.5</size></box></geometry><material><ambient>0.12 0.12 0.12 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material></visual></link>
