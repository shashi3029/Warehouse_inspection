<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="aws_industrial_warehouse">

    <!-- ============================================================== -->
    <!--  Physics & scene                                                -->
    <!-- ============================================================== -->
    <physics name="default_physics" default="0" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver><type>quick</type><iters>50</iters><sor>1.3</sor></solver>
        <constraints>
          <cfm>0.0</cfm><erp>0.2</erp>
          <contact_max_correcting_vel>100.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>1</shadows>
      <grid>false</grid>
    </scene>

    <!-- Dim sun — industrial lights carry primary illumination -->
    <light name="sun" type="directional">
      <cast_shadows>0</cast_shadows>
      <pose>0 0 20 0 0 0</pose>
      <diffuse>0.5 0.5 0.5 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>0.1 0.1 -1</direction>
    </light>

    <!-- ============================================================== -->
    <!--  Industrial overhead lights (3 × 3 grid, ceiling ~8 m)         -->
    <!-- ============================================================== -->
    <light name="lamp_A1" type="point"><pose>-12 -10 7.5 0 0 0</pose><diffuse>0.9 0.9 0.85 1</diffuse><specular>0.3 0.3 0.3 1</specular><attenuation><range>20</range><linear>0.05</linear><constant>0.1</constant><quadratic>0.005</quadratic></attenuation><cast_shadows>0</cast_shadows></light>
    <light name="lamp_A2" type="point"><pose>-12   0 7.5 0 0 0</pose><diffuse>0.9 0.9 0.85 1</diffuse><specular>0.3 0.3 0.3 1</specular><attenuation><range>20</range><linear>0.05</linear><constant>0.1</constant><quadratic>0.005</quadratic></attenuation><cast_shadows>0</cast_shadows></light>
    <light name="lamp_A3" type="point"><pose>-12  10 7.5 0 0 0</pose><diffuse>0.9 0.9 0.85 1</diffuse><specular>0.3 0.3 0.3 1</specular><attenuation><range>20</range><linear>0.05</linear><constant>0.1</constant><quadratic>0.005</quadratic></attenuation><cast_shadows>0</cast_shadows></light>
    <light name="lamp_B1" type="point"><pose>  0 -10 7.5 0 0 0</pose><diffuse>0.9 0.9 0.85 1</diffuse><specular>0.3 0.3 0.3 1</specular><attenuation><range>20</range><linear>0.05</linear><constant>0.1</constant><quadratic>0.005</quadratic></attenuation><cast_shadows>0</cast_shadows></light>
    <light name="lamp_B2" type="point"><pose>  0   0 7.5 0 0 0</pose><diffuse>0.9 0.9 0.85 1</diffuse><specular>0.3 0.3 0.3 1</specular><attenuation><range>20</range><linear>0.05</linear><constant>0.1</constant><quadratic>0.005</quadratic></attenuation><cast_shadows>0</cast_shadows></light>
    <light name="lamp_B3" type="point"><pose>  0  10 7.5 0 0 0</pose><diffuse>0.9 0.9 0.85 1</diffuse><specular>0.3 0.3 0.3 1</specular><attenuation><range>20</range><linear>0.05</linear><constant>0.1</constant><quadratic>0.005</quadratic></attenuation><cast_shadows>0</cast_shadows></light>
    <light name="lamp_C1" type="point"><pose> 12 -10 7.5 0 0 0</pose><diffuse>0.9 0.9 0.85 1</diffuse><specular>0.3 0.3 0.3 1</specular><attenuation><range>20</range><linear>0.05</linear><constant>0.1</constant><quadratic>0.005</quadratic></attenuation><cast_shadows>0</cast_shadows></light>
    <light name="lamp_C2" type="point"><pose> 12   0 7.5 0 0 0</pose><diffuse>0.9 0.9 0.85 1</diffuse><specular>0.3 0.3 0.3 1</specular><attenuation><range>20</range><linear>0.05</linear><constant>0.1</constant><quadratic>0.005</quadratic></attenuation><cast_shadows>0</cast_shadows></light>
    <light name="lamp_C3" type="point"><pose> 12  10 7.5 0 0 0</pose><diffuse>0.9 0.9 0.85 1</diffuse><specular>0.3 0.3 0.3 1</specular><attenuation><range>20</range><linear>0.05</linear><constant>0.1</constant><quadratic>0.005</quadratic></attenuation><cast_shadows>0</cast_shadows></light>

    <!-- ============================================================== -->
    <!--  Ground plane — concrete grey                                   -->
    <!-- ============================================================== -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>60 40</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><plane><normal>0 0 1</normal><size>60 40</size></plane></geometry>
          <material>
            <ambient>0.45 0.45 0.43 1</ambient>
            <diffuse>0.55 0.55 0.52 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================================================== -->
    <!--  Exterior walls (56 m × 36 m footprint, 8 m tall)              -->
    <!-- ============================================================== -->
    <model name="wall_north">
      <static>true</static><pose>0 18 4 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>56 0.3 8</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>56 0.3 8</size></box></geometry><material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_south">
      <static>true</static><pose>0 -18 4 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>56 0.3 8</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>56 0.3 8</size></box></geometry><material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static><pose>-28 0 4 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.3 36 8</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.3 36 8</size></box></geometry><material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
      </link>
    </model>
    <!-- East wall split around 10 m loading dock opening -->
    <model name="wall_east_north">
      <static>true</static><pose>28 13 4 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.3 10 8</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.3 10 8</size></box></geometry><material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_east_south">
      <static>true</static><pose>28 -13 4 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.3 10 8</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.3 10 8</size></box></geometry><material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
      </link>
    </model>
    <model name="dock_header">
      <static>true</static><pose>28 0 7 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.3 12 2</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.3 12 2</size></box></geometry><material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
      </link>
    </model>

