      <link name="pBR"><pose> 2.8  0.45 1.25 0 0 0</pose><collision name="c"><geometry><box><size>0.08 0.08 2.5</size></box></geometry></collision><visual name="v"><geometry><box><size>0.08 0.08 2.5</size></box></geometry><material><ambient>0.12 0.12 0.12 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material></visual></link>
      <!-- Yellow shelf decks: 3 levels -->
      <link name="deck1"><pose>0 0 0.77 0 0 0</pose><collision name="c"><geometry><box><size>5.7 0.88 0.05</size></box></geometry></collision><visual name="v"><geometry><box><size>5.7 0.88 0.05</size></box></geometry><material><ambient>0.72 0.58 0.02 1</ambient><diffuse>0.82 0.66 0.03 1</diffuse></material></visual></link>
      <link name="deck2"><pose>0 0 1.45 0 0 0</pose><collision name="c"><geometry><box><size>5.7 0.88 0.05</size></box></geometry></collision><visual name="v"><geometry><box><size>5.7 0.88 0.05</size></box></geometry><material><ambient>0.72 0.58 0.02 1</ambient><diffuse>0.82 0.66 0.03 1</diffuse></material></visual></link>
      <link name="deck3"><pose>0 0 2.12 0 0 0</pose><collision name="c"><geometry><box><size>5.7 0.88 0.05</size></box></geometry></collision><visual name="v"><geometry><box><size>5.7 0.88 0.05</size></box></geometry><material><ambient>0.72 0.58 0.02 1</ambient><diffuse>0.82 0.66 0.03 1</diffuse></material></visual></link>
      <!-- Cardboard boxes stacked on each level (front row) -->
      <link name="box1a"><pose>0 -0.18 0.95 0 0 0</pose><visual name="v"><geometry><box><size>5.4 0.36 0.30</size></box></geometry><material><ambient>0.58 0.38 0.18 1</ambient><diffuse>0.62 0.42 0.20 1</diffuse></material></visual></link>
      <link name="box2a"><pose>0 -0.18 1.63 0 0 0</pose><visual name="v"><geometry><box><size>5.4 0.36 0.30</size></box></geometry><material><ambient>0.55 0.36 0.16 1</ambient><diffuse>0.60 0.40 0.18 1</diffuse></material></visual></link>
