<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>warehouse_bringup</name>
  <version>1.0.0</version>
  <description>
    Launch files, configurations, and mission files for the warehouse fleet management system.
    Provides full-system, fleet-manager-only, and simulation launch targets.
  </description>
  <maintainer email="warehouse@industrial.com">Warehouse Fleet System</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>warehouse_fleet_manager</exec_depend>
  <exec_depend>warehouse_navigation</exec_depend>
  <exec_depend>warehouse_inspection</exec_depend>
  <exec_depend>warehouse_simulation</exec_depend>
  <exec_depend>warehouse_description</exec_depend>
  <exec_depend>warehouse_msgs</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
