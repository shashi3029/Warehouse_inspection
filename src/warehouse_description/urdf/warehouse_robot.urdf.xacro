<?xml version="1.0"?>
<robot name="warehouse_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Parameters -->
  <xacro:arg name="robot_name"    default="robot1"/>
  <xacro:arg name="robot_id"      default="Robot_1"/>
  <xacro:arg name="laser_enable"  default="true"/>
  <xacro:arg name="camera_enable" default="true"/>
  <xacro:arg name="imu_enable"    default="true"/>

  <xacro:property name="robot_ns"        value="$(arg robot_name)"/>
  <!-- Physics dims — DO NOT CHANGE; spawn height z=0.038 depends on these -->
  <xacro:property name="base_mass"       value="8.2"/>
  <xacro:property name="phys_radius"     value="0.105"/>
  <xacro:property name="phys_height"     value="0.143"/>
  <xacro:property name="wheel_radius"    value="0.033"/>
  <xacro:property name="wheel_width"     value="0.018"/>
  <xacro:property name="wheel_offset_y"  value="0.08"/>
  <xacro:property name="wheel_offset_z"  value="-0.005"/>
  <xacro:property name="caster_offset_x" value="0.064"/>
  <xacro:property name="caster_offset_z" value="-0.004"/>
  <!-- Visual scale — 5x enlarged for warehouse visibility (physics unchanged) -->
  <xacro:property name="body_r"          value="0.650"/>
  <xacro:property name="plate_bot_z"     value="-0.150"/>
  <xacro:property name="plate_top_z"     value=" 0.300"/>
  <xacro:property name="mid_z"           value=" 0.075"/>

  <!-- ── Base footprint ── -->
  <link name="${robot_ns}/base_footprint"/>

  <joint name="${robot_ns}/base_joint" type="fixed">
    <parent link="${robot_ns}/base_footprint"/>
    <child  link="${robot_ns}/base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ═══════════════════════════════════════════════════════════════════
       Base link — TurtleBot3 Burger appearance via multiple <visual>s
       Collision stays as original cylinder (physics unchanged).
       ═══════════════════════════════════════════════════════════════════ -->
  <link name="${robot_ns}/base_link">

    <!-- ── Bottom circular plate ── -->
    <visual>
      <origin xyz="-0.032 0 ${plate_bot_z}" rpy="0 0 0"/>
      <geometry><cylinder length="0.010" radius="${body_r}"/></geometry>
      <material name="tb3_black"><color rgba="0.10 0.10 0.10 1.0"/></material>
    </visual>

    <!-- ── Top circular plate ── -->
    <visual>
      <origin xyz="-0.032 0 ${plate_top_z}" rpy="0 0 0"/>
      <geometry><cylinder length="0.010" radius="${body_r}"/></geometry>
      <material name="tb3_black"/>
    </visual>

    <!-- ── Battery/electronics module (centre, between plates) ── -->
    <visual>
      <origin xyz="-0.240 0 ${mid_z}" rpy="0 0 0"/>
      <geometry><box size="0.425 0.290 0.290"/></geometry>
      <material name="tb3_black"/>
    </visual>

    <!-- ── Front sensor block ── -->
    <visual>
      <origin xyz="0.190 0 ${mid_z}" rpy="0 0 0"/>
      <geometry><box size="0.250 0.200 0.200"/></geometry>
      <material name="tb3_dark_metal"><color rgba="0.18 0.18 0.18 1.0"/></material>
    </visual>

    <!-- ── 4 aluminium standoff columns ── -->
    <visual>
      <origin xyz=" 0.100  0.310 ${mid_z}" rpy="0 0 0"/>
      <geometry><cylinder length="0.450" radius="0.045"/></geometry>
      <material name="tb3_dark_metal"/>
    </visual>
    <visual>
      <origin xyz=" 0.100 -0.310 ${mid_z}" rpy="0 0 0"/>
      <geometry><cylinder length="0.450" radius="0.045"/></geometry>
      <material name="tb3_dark_metal"/>
    </visual>
    <visual>
      <origin xyz="-0.450  0.310 ${mid_z}" rpy="0 0 0"/>
      <geometry><cylinder length="0.450" radius="0.045"/></geometry>
      <material name="tb3_dark_metal"/>
    </visual>
    <visual>
      <origin xyz="-0.450 -0.310 ${mid_z}" rpy="0 0 0"/>
      <geometry><cylinder length="0.450" radius="0.045"/></geometry>
      <material name="tb3_dark_metal"/>
    </visual>

    <!-- ── Visibility beacon: tall orange pole + sphere (clearly visible top-down) ── -->
    <visual>
      <origin xyz="0 0 0.900" rpy="0 0 0"/>
      <geometry><cylinder length="1.600" radius="0.045"/></geometry>
      <material name="beacon_orange"><color rgba="1.0 0.4 0.0 1.0"/></material>
    </visual>
    <visual>
      <origin xyz="0 0 1.750" rpy="0 0 0"/>
      <geometry><sphere radius="0.120"/></geometry>
      <material name="beacon_orange"/>
    </visual>

    <!-- ── Collision (original cylinder — physics unchanged) ── -->
    <collision>
      <origin xyz="-0.032 0 0.0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="${phys_height}" radius="${phys_radius}"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${base_mass}"/>
      <inertia
        ixx="0.051870085"
        iyy="0.051870085"
        izz="0.086765625"
        ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- ── Left Wheel ── -->
  <joint name="${robot_ns}/wheel_left_joint" type="continuous">
    <parent link="${robot_ns}/base_link"/>
    <child  link="${robot_ns}/wheel_left_link"/>
    <origin xyz="0 ${wheel_offset_y} ${wheel_offset_z}" rpy="-1.57 0 0"/>
    <axis   xyz="0 0 1"/>
  </joint>
  <link name="${robot_ns}/wheel_left_link">
    <visual>
      <geometry>
        <cylinder length="${wheel_width}" radius="${wheel_radius}"/>
      </geometry>
      <material name="tb3_tyre"><color rgba="0.08 0.08 0.08 1.0"/></material>
    </visual>
    <collision>
      <geometry>
        <cylinder length="${wheel_width}" radius="${wheel_radius}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.028498940"/>
      <inertia ixx="0.000089127" iyy="0.000089127" izz="0.000147800"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- ── Right Wheel ── -->
  <joint name="${robot_ns}/wheel_right_joint" type="continuous">
    <parent link="${robot_ns}/base_link"/>
    <child  link="${robot_ns}/wheel_right_link"/>
    <origin xyz="0 -${wheel_offset_y} ${wheel_offset_z}" rpy="-1.57 0 0"/>
    <axis   xyz="0 0 1"/>
  </joint>
  <link name="${robot_ns}/wheel_right_link">
    <visual>
      <geometry>
        <cylinder length="${wheel_width}" radius="${wheel_radius}"/>
      </geometry>
      <material name="tb3_tyre"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="${wheel_width}" radius="${wheel_radius}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.028498940"/>
      <inertia ixx="0.000089127" iyy="0.000089127" izz="0.000147800"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- ── Caster ball ── -->
  <joint name="${robot_ns}/caster_back_joint" type="fixed">
    <parent link="${robot_ns}/base_link"/>
    <child  link="${robot_ns}/caster_back_link"/>
    <origin xyz="-${caster_offset_x} 0 ${caster_offset_z}" rpy="-1.57 0 0"/>
  </joint>
  <link name="${robot_ns}/caster_back_link">
    <visual>
      <geometry><sphere radius="0.005"/></geometry>
      <material name="tb3_dark_metal"/>
    </visual>
    <collision>
      <geometry><sphere radius="0.005"/></geometry>
    </collision>
    <inertial>
      <mass value="0.005"/>
      <inertia ixx="8e-6" iyy="8e-6" izz="8e-6" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- ── LiDAR (TurtleBot3 Burger LDS-01 sensor housing) ── -->
  <xacro:if value="$(arg laser_enable)">
    <joint name="${robot_ns}/scan_joint" type="fixed">
      <parent link="${robot_ns}/base_link"/>
      <child  link="${robot_ns}/base_scan"/>
      <origin xyz="-0.160 0 0.860" rpy="0 0 0"/>
    </joint>
    <link name="${robot_ns}/base_scan">
      <!-- Outer housing cylinder (5x scaled) -->
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><cylinder length="0.200" radius="0.190"/></geometry>
        <material name="tb3_lidar_black"><color rgba="0.08 0.08 0.08 1.0"/></material>
      </visual>
      <!-- Sensor window ring -->
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><cylinder length="0.040" radius="0.200"/></geometry>
        <material name="tb3_sensor_ring"><color rgba="0.30 0.30 0.30 1.0"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><cylinder length="0.200" radius="0.190"/></geometry>
      </collision>
      <inertial>
        <mass value="0.114"/>
        <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>

    <gazebo reference="${robot_ns}/base_scan">
      <sensor type="ray" name="${robot_ns}_lidar">
        <pose>0 0 0 0 0 0</pose>
        <visualize>false</visualize>
        <update_rate>10</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159265</min_angle>
              <max_angle> 3.14159265</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.12</min>
            <max>12.0</max>
            <resolution>0.015</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </ray>
        <plugin name="gazebo_ros_lidar" filename="libgazebo_ros_ray_sensor.so">
          <ros>
            <namespace>/${robot_ns}</namespace>
            <remapping>~/out:=scan</remapping>
          </ros>
          <output_type>sensor_msgs/LaserScan</output_type>
          <frame_name>${robot_ns}/base_scan</frame_name>
        </plugin>
      </sensor>
    </gazebo>
  </xacro:if>

  <!-- ── IMU ── -->
  <xacro:if value="$(arg imu_enable)">
    <joint name="${robot_ns}/imu_joint" type="fixed">
      <parent link="${robot_ns}/base_link"/>
      <child  link="${robot_ns}/imu_link"/>
      <origin xyz="-0.032 0 0.068" rpy="0 0 0"/>
    </joint>
    <link name="${robot_ns}/imu_link">
      <inertial>
        <mass value="0.001"/>
        <inertia ixx="1e-9" iyy="1e-9" izz="1e-9" ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>
  </xacro:if>

  <!-- ── Gazebo material overrides ── -->
  <gazebo reference="${robot_ns}/base_link">
    <visual>
      <material>
        <ambient>0.08 0.08 0.08 1</ambient>
        <diffuse>0.12 0.12 0.12 1</diffuse>
        <specular>0.05 0.05 0.05 1</specular>
      </material>
    </visual>
  </gazebo>
  <gazebo reference="${robot_ns}/wheel_left_link">
    <material>Gazebo/FlatBlack</material>
  </gazebo>
  <gazebo reference="${robot_ns}/wheel_right_link">
    <material>Gazebo/FlatBlack</material>
  </gazebo>
  <gazebo reference="${robot_ns}/base_scan">
    <material>Gazebo/FlatBlack</material>
  </gazebo>

  <!-- ── Differential Drive Plugin ── -->
  <gazebo>
    <plugin name="${robot_ns}_diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <namespace>/${robot_ns}</namespace>
      </ros>
      <left_joint>${robot_ns}/wheel_left_joint</left_joint>
      <right_joint>${robot_ns}/wheel_right_joint</right_joint>
      <wheel_separation>0.160</wheel_separation>
      <wheel_diameter>0.066</wheel_diameter>
      <max_wheel_torque>200</max_wheel_torque>
      <max_wheel_acceleration>500.0</max_wheel_acceleration>
      <command_topic>cmd_vel</command_topic>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>true</publish_wheel_tf>
      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>${robot_ns}/base_footprint</robot_base_frame>
    </plugin>
  </gazebo>

</robot>
