<?xml version="1.0"?>
<robot name="warehouse_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="robot_name"    default="robot1"/>
  <xacro:arg name="robot_id"      default="Robot_1"/>
  <xacro:arg name="laser_enable"  default="true"/>
  <xacro:arg name="camera_enable" default="true"/>
  <xacro:arg name="imu_enable"    default="true"/>

  <xacro:property name="robot_ns" value="$(arg robot_name)"/>

  <!-- ══════════════════════════════════════════════════════════════
       5× TurtleBot3 Burger — every dimension is 5× real TB3 Burger
       spawn_z = 0.170 m (≈ wheel_radius 0.165 m + 5 mm buffer)
       base_link origin = wheel axle height above ground
       ground in base_link frame  =  z − 0.170
       ══════════════════════════════════════════════════════════════ -->

  <!-- Physical properties -->
  <xacro:property name="base_mass"       value="8.0"/>
  <xacro:property name="wheel_mass"      value="0.200"/>
  <xacro:property name="wheel_radius"    value="0.165"/>   <!-- 5 × 0.033 -->
  <xacro:property name="wheel_width"     value="0.090"/>   <!-- 5 × 0.018 -->
  <xacro:property name="wheel_sep_half"  value="0.400"/>   <!-- 5 × 0.080 -->
  <xacro:property name="caster_radius"   value="0.050"/>   <!-- 5 × 0.010 -->
  <xacro:property name="plate_r"         value="0.525"/>   <!-- 5 × 0.105 -->
  <xacro:property name="plate_h"         value="0.035"/>   <!-- 5 × 0.007 -->
  <xacro:property name="standoff_r"      value="0.055"/>   <!-- 5 × 0.011 -->
  <xacro:property name="standoff_xy"     value="0.275"/>   <!-- 5 × 0.055 -->

  <!-- z-centres in base_link frame  (ground = −0.170) -->
  <!-- TB3 heights above ground × 5: bottom≈0.060, mid≈0.475, top≈0.890  -->
  <xacro:property name="bot_plate_z"    value="-0.110"/>   <!-- 0.060 m above ground -->
  <xacro:property name="mid_plate_z"    value=" 0.305"/>   <!-- 0.475 m above ground -->
  <xacro:property name="top_plate_z"    value=" 0.720"/>   <!-- 0.890 m above ground -->

  <!-- standoffs span from top face of bottom plate to bottom face of top plate -->
  <!-- len = (top_plate_z − plate_h/2) − (bot_plate_z + plate_h/2) = 0.795    -->
  <xacro:property name="standoff_len"   value="0.795"/>
  <xacro:property name="standoff_z"     value="0.305"/>    <!-- midpoint = mid plate -->

  <!-- LiDAR housing: just above top plate                                      -->
  <!-- housing_h = 0.175,  lidar_z = top_plate_z + plate_h/2 + housing_h/2     -->
  <!--           = 0.720 + 0.0175 + 0.0875 = 0.825                              -->
  <xacro:property name="lidar_z"        value="0.825"/>
  <xacro:property name="lidar_h"        value="0.175"/>
  <xacro:property name="lidar_r"        value="0.190"/>

  <!-- casters: centre at ground + caster_radius = −0.165 + 0.050 = −0.115     -->
  <xacro:property name="caster_z"       value="-0.115"/>

  <!-- Helper: fixed joint -->
  <xacro:macro name="fixed_joint" params="name parent child ox oy oz">
    <joint name="${robot_ns}/${name}" type="fixed">
      <parent link="${robot_ns}/${parent}"/>
      <child  link="${robot_ns}/${child}"/>
      <origin xyz="${ox} ${oy} ${oz}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <!-- ── base footprint ── -->
  <link name="${robot_ns}/base_footprint"/>
  <joint name="${robot_ns}/base_joint" type="fixed">
    <parent link="${robot_ns}/base_footprint"/>
    <child  link="${robot_ns}/base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ══════════════════════════════════════════════════════════════
       1. BASE LINK  —  bottom plate  +  physics / collision
       ══════════════════════════════════════════════════════════════ -->
  <link name="${robot_ns}/base_link">
    <visual>
      <origin xyz="0 0 ${bot_plate_z}" rpy="0 0 0"/>
      <geometry><cylinder length="${plate_h}" radius="${plate_r}"/></geometry>
    </visual>
    <!-- Collision covers full body height so robot doesn't clip shelves -->
    <collision>
      <origin xyz="0 0 0.305" rpy="0 0 0"/>
      <geometry><cylinder length="0.870" radius="${plate_r}"/></geometry>
    </collision>
    <inertial>
      <!-- CoM at mid-body height for stability -->
      <origin xyz="0 0 0.305" rpy="0 0 0"/>
      <mass value="${base_mass}"/>
      <!-- solid cylinder r=0.525, h=0.870: Ixx=Iyy≈1.033, Izz≈1.103 -->
      <inertia ixx="1.033" iyy="1.033" izz="1.103"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <gazebo reference="${robot_ns}/base_link">
    <material>Gazebo/Black</material>
  </gazebo>

  <!-- ══════════════════════════════════════════════════════════════
       2. MIDDLE PLATE
       ══════════════════════════════════════════════════════════════ -->
  <xacro:fixed_joint name="mid_plate_jnt" parent="base_link" child="mid_plate_link"
                     ox="0" oy="0" oz="0"/>
  <link name="${robot_ns}/mid_plate_link">
    <visual>
      <origin xyz="0 0 ${mid_plate_z}" rpy="0 0 0"/>
      <geometry><cylinder length="${plate_h}" radius="${plate_r}"/></geometry>
    </visual>
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="1e-9" iyy="1e-9" izz="1e-9" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <gazebo reference="${robot_ns}/mid_plate_link">
    <material>Gazebo/Black</material>
  </gazebo>

  <!-- ══════════════════════════════════════════════════════════════
       3. TOP PLATE
       ══════════════════════════════════════════════════════════════ -->
  <xacro:fixed_joint name="top_plate_jnt" parent="base_link" child="top_plate_link"
                     ox="0" oy="0" oz="0"/>
  <link name="${robot_ns}/top_plate_link">
    <visual>
      <origin xyz="0 0 ${top_plate_z}" rpy="0 0 0"/>
      <geometry><cylinder length="${plate_h}" radius="${plate_r}"/></geometry>
    </visual>
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="1e-9" iyy="1e-9" izz="1e-9" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <gazebo reference="${robot_ns}/top_plate_link">
    <material>Gazebo/Black</material>
  </gazebo>

  <!-- ══════════════════════════════════════════════════════════════
       4–7. STANDOFF POLES — white aluminium posts
       ══════════════════════════════════════════════════════════════ -->
  <xacro:fixed_joint name="standoff_fl_jnt" parent="base_link" child="standoff_fl_link"
                     ox="${standoff_xy}" oy="${standoff_xy}" oz="${standoff_z}"/>
  <link name="${robot_ns}/standoff_fl_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder length="${standoff_len}" radius="${standoff_r}"/></geometry>
    </visual>
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="1e-9" iyy="1e-9" izz="1e-9" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <gazebo reference="${robot_ns}/standoff_fl_link">
    <material>Gazebo/White</material>
  </gazebo>

  <xacro:fixed_joint name="standoff_fr_jnt" parent="base_link" child="standoff_fr_link"
                     ox="${standoff_xy}" oy="-${standoff_xy}" oz="${standoff_z}"/>
  <link name="${robot_ns}/standoff_fr_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder length="${standoff_len}" radius="${standoff_r}"/></geometry>
    </visual>
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="1e-9" iyy="1e-9" izz="1e-9" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <gazebo reference="${robot_ns}/standoff_fr_link">
    <material>Gazebo/White</material>
  </gazebo>

  <xacro:fixed_joint name="standoff_rl_jnt" parent="base_link" child="standoff_rl_link"
                     ox="-${standoff_xy}" oy="${standoff_xy}" oz="${standoff_z}"/>
  <link name="${robot_ns}/standoff_rl_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder length="${standoff_len}" radius="${standoff_r}"/></geometry>
    </visual>
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="1e-9" iyy="1e-9" izz="1e-9" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <gazebo reference="${robot_ns}/standoff_rl_link">
    <material>Gazebo/White</material>
  </gazebo>

  <xacro:fixed_joint name="standoff_rr_jnt" parent="base_link" child="standoff_rr_link"
                     ox="-${standoff_xy}" oy="-${standoff_xy}" oz="${standoff_z}"/>
  <link name="${robot_ns}/standoff_rr_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder length="${standoff_len}" radius="${standoff_r}"/></geometry>
    </visual>
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="1e-9" iyy="1e-9" izz="1e-9" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <gazebo reference="${robot_ns}/standoff_rr_link">
    <material>Gazebo/White</material>
  </gazebo>

  <!-- ══════════════════════════════════════════════════════════════
       8. LiDAR HOUSING — grey cylinder + dome on top plate
       ══════════════════════════════════════════════════════════════ -->
  <xacro:fixed_joint name="lidar_housing_jnt" parent="base_link" child="lidar_housing_link"
                     ox="0" oy="0" oz="${lidar_z}"/>
  <link name="${robot_ns}/lidar_housing_link">
    <!-- main cylinder body -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder length="${lidar_h}" radius="${lidar_r}"/></geometry>
    </visual>
    <!-- dome cap -->
    <visual>
      <origin xyz="0 0 0.120" rpy="0 0 0"/>
      <geometry><sphere radius="0.140"/></geometry>
    </visual>
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="1e-9" iyy="1e-9" izz="1e-9" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <gazebo reference="${robot_ns}/lidar_housing_link">
    <material>Gazebo/Grey</material>
  </gazebo>

  <!-- ══════════════════════════════════════════════════════════════
       9 & 10. DRIVE WHEELS  (left + right)
       rpy="-π/2 0 0" rotates wheel cylinder axis onto global Y
       ══════════════════════════════════════════════════════════════ -->
  <joint name="${robot_ns}/wheel_left_joint" type="continuous">
    <parent link="${robot_ns}/base_link"/>
    <child  link="${robot_ns}/wheel_left_link"/>
    <origin xyz="0.0 ${wheel_sep_half} 0.0" rpy="-1.5708 0 0"/>
    <axis   xyz="0 0 1"/>
  </joint>
  <link name="${robot_ns}/wheel_left_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder length="${wheel_width}" radius="${wheel_radius}"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder length="${wheel_width}" radius="${wheel_radius}"/></geometry>
    </collision>
    <inertial>
      <mass value="${wheel_mass}"/>
      <!-- cylinder spinning about Z: Ixx=Iyy=m(3r²+h²)/12, Izz=mr²/2 -->
      <inertia ixx="0.00150" iyy="0.00150" izz="0.00272"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <gazebo reference="${robot_ns}/wheel_left_link">
    <material>Gazebo/FlatBlack</material>
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>

  <joint name="${robot_ns}/wheel_right_joint" type="continuous">
    <parent link="${robot_ns}/base_link"/>
    <child  link="${robot_ns}/wheel_right_link"/>
    <origin xyz="0.0 -${wheel_sep_half} 0.0" rpy="-1.5708 0 0"/>
    <axis   xyz="0 0 1"/>
  </joint>
  <link name="${robot_ns}/wheel_right_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder length="${wheel_width}" radius="${wheel_radius}"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder length="${wheel_width}" radius="${wheel_radius}"/></geometry>
    </collision>
    <inertial>
      <mass value="${wheel_mass}"/>
      <inertia ixx="0.00150" iyy="0.00150" izz="0.00272"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <gazebo reference="${robot_ns}/wheel_right_link">
    <material>Gazebo/FlatBlack</material>
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>

  <!-- ══════════════════════════════════════════════════════════════
       11 & 12. CASTER BALLS  (front + rear)  — zero friction
       ══════════════════════════════════════════════════════════════ -->
  <joint name="${robot_ns}/caster_front_joint" type="fixed">
    <parent link="${robot_ns}/base_link"/>
    <child  link="${robot_ns}/caster_front_link"/>
    <origin xyz="0.300 0.0 ${caster_z}" rpy="0 0 0"/>
  </joint>
  <link name="${robot_ns}/caster_front_link">
    <visual><geometry><sphere radius="${caster_radius}"/></geometry></visual>
    <collision><geometry><sphere radius="${caster_radius}"/></geometry></collision>
    <inertial>
      <mass value="0.010"/>
      <inertia ixx="4e-7" iyy="4e-7" izz="4e-7" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <gazebo reference="${robot_ns}/caster_front_link">
    <material>Gazebo/DarkGrey</material>
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>

  <joint name="${robot_ns}/caster_rear_joint" type="fixed">
    <parent link="${robot_ns}/base_link"/>
    <child  link="${robot_ns}/caster_rear_link"/>
    <origin xyz="-0.300 0.0 ${caster_z}" rpy="0 0 0"/>
  </joint>
  <link name="${robot_ns}/caster_rear_link">
    <visual><geometry><sphere radius="${caster_radius}"/></geometry></visual>
    <collision><geometry><sphere radius="${caster_radius}"/></geometry></collision>
    <inertial>
      <mass value="0.010"/>
      <inertia ixx="4e-7" iyy="4e-7" izz="4e-7" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <gazebo reference="${robot_ns}/caster_rear_link">
    <material>Gazebo/DarkGrey</material>
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>

  <!-- ══════════════════════════════════════════════════════════════
       13. LiDAR SENSOR — positioned at top of housing
       ══════════════════════════════════════════════════════════════ -->
  <xacro:if value="$(arg laser_enable)">
    <joint name="${robot_ns}/scan_joint" type="fixed">
      <parent link="${robot_ns}/base_link"/>
      <child  link="${robot_ns}/base_scan"/>
      <origin xyz="0 0 ${lidar_z}" rpy="0 0 0"/>
    </joint>
    <link name="${robot_ns}/base_scan">
      <inertial>
        <mass value="0.001"/>
        <inertia ixx="1e-9" iyy="1e-9" izz="1e-9" ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>
    <gazebo reference="${robot_ns}/base_scan">
      <sensor type="ray" name="${robot_ns}_lidar">
        <pose>0 0 0 0 0 0</pose>
        <visualize>false</visualize>
        <update_rate>10</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159265</min_angle>
              <max_angle> 3.14159265</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.20</min>
            <max>15.0</max>
            <resolution>0.015</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </ray>
        <plugin name="gazebo_ros_lidar" filename="libgazebo_ros_ray_sensor.so">
          <ros>
            <namespace>/${robot_ns}</namespace>
            <remapping>~/out:=scan</remapping>
          </ros>
          <output_type>sensor_msgs/LaserScan</output_type>
          <frame_name>${robot_ns}/base_scan</frame_name>
        </plugin>
      </sensor>
    </gazebo>
  </xacro:if>

  <!-- ══════════════════════════════════════════════════════════════
       14. IMU
       ══════════════════════════════════════════════════════════════ -->
  <xacro:if value="$(arg imu_enable)">
    <joint name="${robot_ns}/imu_joint" type="fixed">
      <parent link="${robot_ns}/base_link"/>
      <child  link="${robot_ns}/imu_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
    <link name="${robot_ns}/imu_link">
      <inertial>
        <mass value="0.001"/>
        <inertia ixx="1e-9" iyy="1e-9" izz="1e-9" ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>
  </xacro:if>

  <!-- ══════════════════════════════════════════════════════════════
       DIFFERENTIAL DRIVE PLUGIN
       5× TB3 Burger: sep=0.800 m, diam=0.330 m
       torque=20 Nm, accel=30 rad/s² → linear accel ≈ 5 m/s²
       ══════════════════════════════════════════════════════════════ -->
  <gazebo>
    <plugin name="${robot_ns}_diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <namespace>/${robot_ns}</namespace>
      </ros>
      <left_joint>${robot_ns}/wheel_left_joint</left_joint>
      <right_joint>${robot_ns}/wheel_right_joint</right_joint>
      <wheel_separation>0.800</wheel_separation>
      <wheel_diameter>0.330</wheel_diameter>
      <max_wheel_torque>20</max_wheel_torque>
      <max_wheel_acceleration>30.0</max_wheel_acceleration>
      <command_topic>cmd_vel</command_topic>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>true</publish_wheel_tf>
      <odometry_topic>odom</odometry_topic>
      <odometry_frame>${robot_ns}/odom</odometry_frame>
      <robot_base_frame>${robot_ns}/base_footprint</robot_base_frame>
    </plugin>
  </gazebo>

</robot>
