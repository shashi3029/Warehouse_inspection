<?xml version="1.0"?>
<robot name="warehouse_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Args — identical to original for launch-file compatibility -->
  <xacro:arg name="robot_name"    default="robot1"/>
  <xacro:arg name="robot_id"      default="Robot_1"/>
  <xacro:arg name="laser_enable"  default="true"/>
  <xacro:arg name="camera_enable" default="true"/>
  <xacro:arg name="imu_enable"    default="true"/>

  <xacro:property name="robot_ns" value="$(arg robot_name)"/>

  <!-- ═══════════════════════════════════════════════════════════════════
       TurtleBot3 Burger dimensions
       spawn height z = 0.033 m  (= wheel_radius)
       base_link frame origin  = wheel axle height
       ground plane at         = z − 0.033 m in base_link frame
       ═══════════════════════════════════════════════════════════════════ -->
  <xacro:property name="base_mass"      value="1.0"/>
  <xacro:property name="wheel_radius"   value="0.033"/>
  <xacro:property name="wheel_width"    value="0.018"/>
  <xacro:property name="wheel_sep_half" value="0.080"/>   <!-- 0.160 m / 2 -->
  <xacro:property name="caster_radius"  value="0.010"/>

  <!-- Positions in base_link frame (ground = −0.033) -->
  <!-- bottom plate centre: 0.010 m above ground → −0.033+0.010+0.0035 = −0.0195 -->
  <xacro:property name="bottom_plate_z" value="-0.020"/>
  <!-- top plate centre: 0.190 m above ground → −0.033+0.190+0.0035 = 0.1605 -->
  <xacro:property name="top_plate_z"    value="0.161"/>
  <!-- standoff centre (midpoint between plates) -->
  <xacro:property name="standoff_z"     value="0.071"/>
  <xacro:property name="standoff_len"   value="0.174"/>
  <!-- lidar base just above top plate -->
  <xacro:property name="lidar_z"        value="0.185"/>
  <!-- casters: bottom touches ground → centre at −0.033+caster_radius -->
  <xacro:property name="caster_z"       value="-0.023"/>

  <!-- Helper: fixed joint -->
  <xacro:macro name="fixed_joint" params="name parent child ox oy oz">
    <joint name="${robot_ns}/${name}" type="fixed">
      <parent link="${robot_ns}/${parent}"/>
      <child  link="${robot_ns}/${child}"/>
      <origin xyz="${ox} ${oy} ${oz}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <!-- ── base footprint ── -->
  <link name="${robot_ns}/base_footprint"/>
  <joint name="${robot_ns}/base_joint" type="fixed">
    <parent link="${robot_ns}/base_footprint"/>
    <child  link="${robot_ns}/base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ═══════════════════════════════════════════════════════════════════
       1. BASE LINK — bottom circular plate + physics
       ═══════════════════════════════════════════════════════════════════ -->
  <link name="${robot_ns}/base_link">
    <visual>
      <origin xyz="0 0 ${bottom_plate_z}" rpy="0 0 0"/>
      <geometry><cylinder length="0.007" radius="0.105"/></geometry>
    </visual>
    <collision>
      <!-- Flat cylinder collision to keep robot on ground -->
      <origin xyz="0 0 ${bottom_plate_z}" rpy="0 0 0"/>
      <geometry><cylinder length="0.100" radius="0.105"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${bottom_plate_z}" rpy="0 0 0"/>
      <mass value="${base_mass}"/>
      <!-- Thin cylinder: Ixx=Iyy=m(3r²+h²)/12, Izz=mr²/2 -->
      <inertia ixx="0.00277" iyy="0.00277" izz="0.00551"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <gazebo reference="${robot_ns}/base_link">
    <material>Gazebo/DarkGrey</material>
  </gazebo>

  <!-- ═══════════════════════════════════════════════════════════════════
       2. TOP PLATE — second circular plate
       ═══════════════════════════════════════════════════════════════════ -->
  <xacro:fixed_joint name="top_plate_jnt" parent="base_link" child="top_plate_link"
                     ox="0" oy="0" oz="0"/>
  <link name="${robot_ns}/top_plate_link">
    <visual>
      <origin xyz="0 0 ${top_plate_z}" rpy="0 0 0"/>
      <geometry><cylinder length="0.007" radius="0.105"/></geometry>
    </visual>
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="1e-9" iyy="1e-9" izz="1e-9" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <gazebo reference="${robot_ns}/top_plate_link">
    <material>Gazebo/DarkGrey</material>
  </gazebo>

  <!-- ═══════════════════════════════════════════════════════════════════
       3–6. STANDOFF POLES (front-left, front-right, rear-left, rear-right)
       ═══════════════════════════════════════════════════════════════════ -->
  <xacro:fixed_joint name="standoff_fl_jnt" parent="base_link" child="standoff_fl_link"
                     ox="0.055" oy="0.055" oz="${standoff_z}"/>
  <link name="${robot_ns}/standoff_fl_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder length="${standoff_len}" radius="0.011"/></geometry>
    </visual>
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="1e-9" iyy="1e-9" izz="1e-9" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <gazebo reference="${robot_ns}/standoff_fl_link">
    <material>Gazebo/DarkGrey</material>
  </gazebo>

  <xacro:fixed_joint name="standoff_fr_jnt" parent="base_link" child="standoff_fr_link"
                     ox="0.055" oy="-0.055" oz="${standoff_z}"/>
  <link name="${robot_ns}/standoff_fr_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder length="${standoff_len}" radius="0.011"/></geometry>
    </visual>
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="1e-9" iyy="1e-9" izz="1e-9" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <gazebo reference="${robot_ns}/standoff_fr_link">
    <material>Gazebo/DarkGrey</material>
  </gazebo>

  <xacro:fixed_joint name="standoff_rl_jnt" parent="base_link" child="standoff_rl_link"
                     ox="-0.055" oy="0.055" oz="${standoff_z}"/>
  <link name="${robot_ns}/standoff_rl_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder length="${standoff_len}" radius="0.011"/></geometry>
    </visual>
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="1e-9" iyy="1e-9" izz="1e-9" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <gazebo reference="${robot_ns}/standoff_rl_link">
    <material>Gazebo/DarkGrey</material>
  </gazebo>

  <xacro:fixed_joint name="standoff_rr_jnt" parent="base_link" child="standoff_rr_link"
                     ox="-0.055" oy="-0.055" oz="${standoff_z}"/>
  <link name="${robot_ns}/standoff_rr_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder length="${standoff_len}" radius="0.011"/></geometry>
    </visual>
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="1e-9" iyy="1e-9" izz="1e-9" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <gazebo reference="${robot_ns}/standoff_rr_link">
    <material>Gazebo/DarkGrey</material>
  </gazebo>

  <!-- ═══════════════════════════════════════════════════════════════════
       7. LiDAR HOUSING — dark cylinder on top plate
       ═══════════════════════════════════════════════════════════════════ -->
  <xacro:fixed_joint name="lidar_housing_jnt" parent="base_link" child="lidar_housing_link"
                     ox="0" oy="0" oz="${lidar_z}"/>
  <link name="${robot_ns}/lidar_housing_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder length="0.035" radius="0.038"/></geometry>
    </visual>
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="1e-9" iyy="1e-9" izz="1e-9" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <gazebo reference="${robot_ns}/lidar_housing_link">
    <material>Gazebo/Black</material>
  </gazebo>

  <!-- ═══════════════════════════════════════════════════════════════════
       8 & 9. DRIVE WHEELS (left + right)
       ═══════════════════════════════════════════════════════════════════ -->
  <joint name="${robot_ns}/wheel_left_joint" type="continuous">
    <parent link="${robot_ns}/base_link"/>
    <child  link="${robot_ns}/wheel_left_link"/>
    <origin xyz="0.0 ${wheel_sep_half} 0.0" rpy="-1.5708 0 0"/>
    <axis   xyz="0 0 1"/>
  </joint>
  <link name="${robot_ns}/wheel_left_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder length="${wheel_width}" radius="${wheel_radius}"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder length="${wheel_width}" radius="${wheel_radius}"/></geometry>
    </collision>
    <inertial>
      <mass value="0.028"/>
      <inertia ixx="0.000008" iyy="0.000008" izz="0.000015"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <gazebo reference="${robot_ns}/wheel_left_link">
    <material>Gazebo/FlatBlack</material>
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>

  <joint name="${robot_ns}/wheel_right_joint" type="continuous">
    <parent link="${robot_ns}/base_link"/>
    <child  link="${robot_ns}/wheel_right_link"/>
    <origin xyz="0.0 -${wheel_sep_half} 0.0" rpy="-1.5708 0 0"/>
    <axis   xyz="0 0 1"/>
  </joint>
  <link name="${robot_ns}/wheel_right_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder length="${wheel_width}" radius="${wheel_radius}"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder length="${wheel_width}" radius="${wheel_radius}"/></geometry>
    </collision>
    <inertial>
      <mass value="0.028"/>
      <inertia ixx="0.000008" iyy="0.000008" izz="0.000015"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <gazebo reference="${robot_ns}/wheel_right_link">
    <material>Gazebo/FlatBlack</material>
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>

  <!-- ═══════════════════════════════════════════════════════════════════
       10 & 11. CASTER BALLS (front + rear) — low friction
       ═══════════════════════════════════════════════════════════════════ -->
  <joint name="${robot_ns}/caster_front_joint" type="fixed">
    <parent link="${robot_ns}/base_link"/>
    <child  link="${robot_ns}/caster_front_link"/>
    <origin xyz="0.060 0.0 ${caster_z}" rpy="0 0 0"/>
  </joint>
  <link name="${robot_ns}/caster_front_link">
    <visual><geometry><sphere radius="${caster_radius}"/></geometry></visual>
    <collision><geometry><sphere radius="${caster_radius}"/></geometry></collision>
    <inertial>
      <mass value="0.005"/>
      <inertia ixx="2e-7" iyy="2e-7" izz="2e-7" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <gazebo reference="${robot_ns}/caster_front_link">
    <material>Gazebo/Grey</material>
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>

  <joint name="${robot_ns}/caster_rear_joint" type="fixed">
    <parent link="${robot_ns}/base_link"/>
    <child  link="${robot_ns}/caster_rear_link"/>
    <origin xyz="-0.060 0.0 ${caster_z}" rpy="0 0 0"/>
  </joint>
  <link name="${robot_ns}/caster_rear_link">
    <visual><geometry><sphere radius="${caster_radius}"/></geometry></visual>
    <collision><geometry><sphere radius="${caster_radius}"/></geometry></collision>
    <inertial>
      <mass value="0.005"/>
      <inertia ixx="2e-7" iyy="2e-7" izz="2e-7" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <gazebo reference="${robot_ns}/caster_rear_link">
    <material>Gazebo/Grey</material>
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>

  <!-- ═══════════════════════════════════════════════════════════════════
       12. LiDAR SENSOR
       ═══════════════════════════════════════════════════════════════════ -->
  <xacro:if value="$(arg laser_enable)">
    <joint name="${robot_ns}/scan_joint" type="fixed">
      <parent link="${robot_ns}/base_link"/>
      <child  link="${robot_ns}/base_scan"/>
      <origin xyz="0 0 ${lidar_z}" rpy="0 0 0"/>
    </joint>
    <link name="${robot_ns}/base_scan">
      <inertial>
        <mass value="0.001"/>
        <inertia ixx="1e-9" iyy="1e-9" izz="1e-9" ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>
    <gazebo reference="${robot_ns}/base_scan">
      <sensor type="ray" name="${robot_ns}_lidar">
        <pose>0 0 0 0 0 0</pose>
        <visualize>false</visualize>
        <update_rate>10</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159265</min_angle>
              <max_angle> 3.14159265</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.12</min>
            <max>3.5</max>
            <resolution>0.015</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </ray>
        <plugin name="gazebo_ros_lidar" filename="libgazebo_ros_ray_sensor.so">
          <ros>
            <namespace>/${robot_ns}</namespace>
            <remapping>~/out:=scan</remapping>
          </ros>
          <output_type>sensor_msgs/LaserScan</output_type>
          <frame_name>${robot_ns}/base_scan</frame_name>
        </plugin>
      </sensor>
    </gazebo>
  </xacro:if>

  <!-- ═══════════════════════════════════════════════════════════════════
       13. IMU
       ═══════════════════════════════════════════════════════════════════ -->
  <xacro:if value="$(arg imu_enable)">
    <joint name="${robot_ns}/imu_joint" type="fixed">
      <parent link="${robot_ns}/base_link"/>
      <child  link="${robot_ns}/imu_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
    <link name="${robot_ns}/imu_link">
      <inertial>
        <mass value="0.001"/>
        <inertia ixx="1e-9" iyy="1e-9" izz="1e-9" ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>
  </xacro:if>

  <!-- ═══════════════════════════════════════════════════════════════════
       DIFFERENTIAL DRIVE PLUGIN — TurtleBot3 Burger parameters
       wheel_sep=0.160 m, wheel_diam=0.066 m
       ═══════════════════════════════════════════════════════════════════ -->
  <gazebo>
    <plugin name="${robot_ns}_diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <namespace>/${robot_ns}</namespace>
      </ros>
      <left_joint>${robot_ns}/wheel_left_joint</left_joint>
      <right_joint>${robot_ns}/wheel_right_joint</right_joint>
      <wheel_separation>0.160</wheel_separation>
      <wheel_diameter>0.066</wheel_diameter>
      <max_wheel_torque>5</max_wheel_torque>
      <max_wheel_acceleration>50.0</max_wheel_acceleration>
      <command_topic>cmd_vel</command_topic>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>true</publish_wheel_tf>
      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>${robot_ns}/base_footprint</robot_base_frame>
    </plugin>
  </gazebo>

</robot>
