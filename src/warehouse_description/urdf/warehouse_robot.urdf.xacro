<?xml version="1.0"?>
<robot name="warehouse_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Args — kept identical for full launch-file compatibility -->
  <xacro:arg name="robot_name"    default="robot1"/>
  <xacro:arg name="robot_id"      default="Robot_1"/>
  <xacro:arg name="laser_enable"  default="true"/>
  <xacro:arg name="camera_enable" default="true"/>
  <xacro:arg name="imu_enable"    default="true"/>

  <xacro:property name="robot_ns" value="$(arg robot_name)"/>

  <!-- ═══════════════════════════════════════════════════════════════════
       PHYSICS (spawn height z=0.175 = wheel_radius 0.170 + offset 0.005)
       All visuals use package://warehouse_description/meshes/*.stl
       which are installed by CMakeLists to share/warehouse_description/meshes/
       ═══════════════════════════════════════════════════════════════════ -->
  <xacro:property name="base_mass"       value="60.0"/>
  <xacro:property name="wheel_radius"    value="0.170"/>
  <xacro:property name="wheel_width"     value="0.080"/>
  <xacro:property name="wheel_sep_half"  value="0.290"/>
  <xacro:property name="wheel_offset_z"  value="-0.005"/>
  <xacro:property name="caster_radius"   value="0.050"/>
  <xacro:property name="caster_z"        value="-0.125"/>
  <xacro:property name="caster_front_x"  value=" 0.390"/>
  <xacro:property name="caster_rear_x"   value="-0.390"/>
  <xacro:property name="body_z"          value="0.045"/>
  <xacro:property name="body_h"          value="0.400"/>

  <!-- ── base footprint ── -->
  <link name="${robot_ns}/base_footprint"/>

  <joint name="${robot_ns}/base_joint" type="fixed">
    <parent link="${robot_ns}/base_footprint"/>
    <child  link="${robot_ns}/base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ═══════════════════════════════════════════════════════════════════
       BASE LINK — mesh-based industrial warehouse AMR
       Each visual uses a separate STL so Gazebo can colour them
       independently via material overrides.
       ═══════════════════════════════════════════════════════════════════ -->
  <link name="${robot_ns}/base_link">

    <!-- ── Main orange body ── -->
    <visual name="body">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://warehouse_description/meshes/amr_body.stl"/>
      </geometry>
      <material name="amr_orange"><color rgba="1.00 0.55 0.00 1.0"/></material>
    </visual>

    <!-- ── Dark lid plate ── -->
    <visual name="lid">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://warehouse_description/meshes/amr_lid.stl"/>
      </geometry>
      <material name="amr_charcoal"><color rgba="0.14 0.14 0.14 1.0"/></material>
    </visual>

    <!-- ── Front bumper ── -->
    <visual name="bumper_front">
      <origin xyz="0.480 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://warehouse_description/meshes/amr_bumper_front.stl"/>
      </geometry>
      <material name="amr_charcoal"/>
    </visual>

    <!-- ── Rear bumper ── -->
    <visual name="bumper_rear">
      <origin xyz="-0.480 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://warehouse_description/meshes/amr_bumper_rear.stl"/>
      </geometry>
      <material name="amr_charcoal"/>
    </visual>

    <!-- ── Central identification mast (tapered frustum) ── -->
    <visual name="mast">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://warehouse_description/meshes/amr_mast.stl"/>
      </geometry>
      <material name="amr_orange"/>
    </visual>

    <!-- ── 360° sensor ring (torus) ── -->
    <visual name="sensor_ring">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://warehouse_description/meshes/amr_sensor_ring.stl"/>
      </geometry>
      <material name="amr_sensor"><color rgba="0.30 0.30 0.30 1.0"/></material>
    </visual>

    <!-- ── Safety beacon cylinder ── -->
    <visual name="beacon_body">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://warehouse_description/meshes/amr_beacon.stl"/>
      </geometry>
      <material name="amr_blue"><color rgba="0.10 0.45 1.00 1.0"/></material>
    </visual>

    <!-- ── Safety beacon dome ── -->
    <visual name="beacon_dome">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://warehouse_description/meshes/amr_dome.stl"/>
      </geometry>
      <material name="amr_blue"/>
    </visual>

    <!-- ── Physical collision — full body box ── -->
    <collision>
      <origin xyz="0 0 ${body_z}" rpy="0 0 0"/>
      <geometry><box size="0.960 0.660 ${body_h}"/></geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 ${body_z}" rpy="0 0 0"/>
      <mass value="${base_mass}"/>
      <!-- Solid box m=60, l=0.9, w=0.65, h=0.4 -->
      <inertia ixx="2.913" iyy="4.850" izz="6.163"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- ── Left Drive Wheel ── -->
  <joint name="${robot_ns}/wheel_left_joint" type="continuous">
    <parent link="${robot_ns}/base_link"/>
    <child  link="${robot_ns}/wheel_left_link"/>
    <origin xyz="0 ${wheel_sep_half} ${wheel_offset_z}" rpy="-1.5708 0 0"/>
    <axis   xyz="0 0 1"/>
  </joint>
  <link name="${robot_ns}/wheel_left_link">
    <visual name="wheel">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://warehouse_description/meshes/amr_wheel.stl"/>
      </geometry>
      <material name="amr_tyre"><color rgba="0.08 0.08 0.08 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="${wheel_width}" radius="${wheel_radius}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.800"/>
      <inertia ixx="0.00621" iyy="0.00621" izz="0.01156"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- ── Right Drive Wheel ── -->
  <joint name="${robot_ns}/wheel_right_joint" type="continuous">
    <parent link="${robot_ns}/base_link"/>
    <child  link="${robot_ns}/wheel_right_link"/>
    <origin xyz="0 -${wheel_sep_half} ${wheel_offset_z}" rpy="-1.5708 0 0"/>
    <axis   xyz="0 0 1"/>
  </joint>
  <link name="${robot_ns}/wheel_right_link">
    <visual name="wheel">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://warehouse_description/meshes/amr_wheel.stl"/>
      </geometry>
      <material name="amr_tyre"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="${wheel_width}" radius="${wheel_radius}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.800"/>
      <inertia ixx="0.00621" iyy="0.00621" izz="0.01156"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- ── Front Caster ── -->
  <joint name="${robot_ns}/caster_front_joint" type="fixed">
    <parent link="${robot_ns}/base_link"/>
    <child  link="${robot_ns}/caster_front_link"/>
    <origin xyz="${caster_front_x} 0 ${caster_z}" rpy="0 0 0"/>
  </joint>
  <link name="${robot_ns}/caster_front_link">
    <visual>
      <geometry><sphere radius="${caster_radius}"/></geometry>
      <material name="amr_charcoal"/>
    </visual>
    <collision>
      <geometry><sphere radius="${caster_radius}"/></geometry>
    </collision>
    <inertial>
      <mass value="0.100"/>
      <inertia ixx="1e-4" iyy="1e-4" izz="1e-4" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- ── Rear Caster ── -->
  <joint name="${robot_ns}/caster_rear_joint" type="fixed">
    <parent link="${robot_ns}/base_link"/>
    <child  link="${robot_ns}/caster_rear_link"/>
    <origin xyz="${caster_rear_x} 0 ${caster_z}" rpy="0 0 0"/>
  </joint>
  <link name="${robot_ns}/caster_rear_link">
    <visual>
      <geometry><sphere radius="${caster_radius}"/></geometry>
      <material name="amr_charcoal"/>
    </visual>
    <collision>
      <geometry><sphere radius="${caster_radius}"/></geometry>
    </collision>
    <inertial>
      <mass value="0.100"/>
      <inertia ixx="1e-4" iyy="1e-4" izz="1e-4" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- ── LiDAR — at sensor ring height (0.896 m above ground) ── -->
  <xacro:if value="$(arg laser_enable)">
    <joint name="${robot_ns}/scan_joint" type="fixed">
      <parent link="${robot_ns}/base_link"/>
      <child  link="${robot_ns}/base_scan"/>
      <origin xyz="0 0 0.721" rpy="0 0 0"/>
    </joint>
    <link name="${robot_ns}/base_scan">
      <inertial>
        <mass value="0.114"/>
        <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>
    <gazebo reference="${robot_ns}/base_scan">
      <sensor type="ray" name="${robot_ns}_lidar">
        <pose>0 0 0 0 0 0</pose>
        <visualize>false</visualize>
        <update_rate>10</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159265</min_angle>
              <max_angle> 3.14159265</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.15</min>
            <max>25.0</max>
            <resolution>0.015</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </ray>
        <plugin name="gazebo_ros_lidar" filename="libgazebo_ros_ray_sensor.so">
          <ros>
            <namespace>/${robot_ns}</namespace>
            <remapping>~/out:=scan</remapping>
          </ros>
          <output_type>sensor_msgs/LaserScan</output_type>
          <frame_name>${robot_ns}/base_scan</frame_name>
        </plugin>
      </sensor>
    </gazebo>
  </xacro:if>

  <!-- ── IMU ── -->
  <xacro:if value="$(arg imu_enable)">
    <joint name="${robot_ns}/imu_joint" type="fixed">
      <parent link="${robot_ns}/base_link"/>
      <child  link="${robot_ns}/imu_link"/>
      <origin xyz="0 0 ${body_z}" rpy="0 0 0"/>
    </joint>
    <link name="${robot_ns}/imu_link">
      <inertial>
        <mass value="0.001"/>
        <inertia ixx="1e-9" iyy="1e-9" izz="1e-9" ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>
  </xacro:if>

  <!-- ── Gazebo material overrides ── -->
  <!-- Body parts: Gazebo uses its own material system for meshes -->
  <gazebo reference="${robot_ns}/base_link">
    <visual>
      <material>
        <ambient>0.90 0.50 0.00 1</ambient>
        <diffuse>1.00 0.55 0.00 1</diffuse>
        <specular>0.40 0.25 0.05 1</specular>
        <emissive>0.04 0.02 0.00 1</emissive>
      </material>
    </visual>
  </gazebo>
  <gazebo reference="${robot_ns}/wheel_left_link">
    <material>Gazebo/FlatBlack</material>
  </gazebo>
  <gazebo reference="${robot_ns}/wheel_right_link">
    <material>Gazebo/FlatBlack</material>
  </gazebo>

  <!-- ── Differential Drive Plugin ── -->
  <gazebo>
    <plugin name="${robot_ns}_diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <namespace>/${robot_ns}</namespace>
      </ros>
      <left_joint>${robot_ns}/wheel_left_joint</left_joint>
      <right_joint>${robot_ns}/wheel_right_joint</right_joint>
      <wheel_separation>0.580</wheel_separation>
      <wheel_diameter>0.340</wheel_diameter>
      <!-- 80 Nm / 40 rad/s²: smooth 0→3.5 m/s in ~0.5 s; no tipping with 60 kg mass -->
      <max_wheel_torque>80</max_wheel_torque>
      <max_wheel_acceleration>40.0</max_wheel_acceleration>
      <command_topic>cmd_vel</command_topic>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>true</publish_wheel_tf>
      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>${robot_ns}/base_footprint</robot_base_frame>
    </plugin>
  </gazebo>

</robot>
