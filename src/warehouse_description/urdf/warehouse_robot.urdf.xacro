<?xml version="1.0"?>
<robot name="warehouse_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Args — identical to original for launch-file compatibility -->
  <xacro:arg name="robot_name"    default="robot1"/>
  <xacro:arg name="robot_id"      default="Robot_1"/>
  <xacro:arg name="laser_enable"  default="true"/>
  <xacro:arg name="camera_enable" default="true"/>
  <xacro:arg name="imu_enable"    default="true"/>

  <xacro:property name="robot_ns" value="$(arg robot_name)"/>

  <!-- ═══════════════════════════════════════════════════════════════════
       PHYSICS  — spawn height z = 0.175 m  (= wheel_radius + |offset|)
       Ground plane is at base_link z = −0.175 m
       ═══════════════════════════════════════════════════════════════════ -->
  <xacro:property name="base_mass"       value="60.0"/>
  <xacro:property name="wheel_radius"    value="0.170"/>
  <xacro:property name="wheel_width"     value="0.080"/>
  <xacro:property name="wheel_sep_half"  value="0.290"/>   <!-- 0.580 m axle / 2 -->
  <xacro:property name="wheel_offset_z"  value="-0.005"/>
  <xacro:property name="caster_radius"   value="0.050"/>
  <!-- caster bottom must touch ground: caster_z = caster_radius − spawn_z = 0.050−0.175 -->
  <xacro:property name="caster_z"        value="-0.125"/>
  <xacro:property name="caster_front_x"  value=" 0.395"/>
  <xacro:property name="caster_rear_x"   value="-0.395"/>

  <!-- Pre-computed geometry constants (base_link frame) -->
  <!-- body_bottom = -0.175 + 0.020(clearance) = -0.155                  -->
  <!-- body_z      = -0.155 + 0.200             =  0.045  (body centre)   -->
  <!-- body_top    =  0.045 + 0.200             =  0.245                  -->
  <!-- lid_cz      =  0.245 + 0.013             =  0.258                  -->
  <!-- bumper_cz   = -0.155 + 0.130             = -0.025                  -->
  <!-- mast_cz     =  0.271 + 0.450             =  0.721  (mast centre)   -->
  <!-- beacon_cz   =  1.171 + 0.110             =  1.281                  -->
  <!-- dome_cz     =  1.281 + 0.100 + 0.090     =  1.471                  -->

  <xacro:property name="body_z"   value=" 0.045"/>
  <xacro:property name="body_h"   value=" 0.400"/>

  <!-- ════════════════════════════════════════
       Helper macro: inertia-free visual link
       (used for all decoration-only links)
       ════════════════════════════════════════ -->
  <xacro:macro name="visual_link" params="name">
    <link name="${robot_ns}/${name}">
      <inertial>
        <mass value="0.001"/>
        <inertia ixx="1e-9" iyy="1e-9" izz="1e-9" ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>
  </xacro:macro>

  <xacro:macro name="fixed_joint" params="name parent child ox oy oz">
    <joint name="${robot_ns}/${name}" type="fixed">
      <parent link="${robot_ns}/${parent}"/>
      <child  link="${robot_ns}/${child}"/>
      <origin xyz="${ox} ${oy} ${oz}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <!-- ── base footprint ── -->
  <link name="${robot_ns}/base_footprint"/>
  <joint name="${robot_ns}/base_joint" type="fixed">
    <parent link="${robot_ns}/base_footprint"/>
    <child  link="${robot_ns}/base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ═══════════════════════════════════════════════════════════════════
       1. BASE LINK — orange body box + collision + inertia
       ═══════════════════════════════════════════════════════════════════ -->
  <link name="${robot_ns}/base_link">
    <visual>
      <origin xyz="0 0 ${body_z}" rpy="0 0 0"/>
      <geometry><box size="0.900 0.650 0.400"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 ${body_z}" rpy="0 0 0"/>
      <geometry><box size="0.960 0.660 0.400"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${body_z}" rpy="0 0 0"/>
      <mass value="${base_mass}"/>
      <inertia ixx="2.913" iyy="4.850" izz="6.163"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <gazebo reference="${robot_ns}/base_link">
    <material>
      <ambient>0.90 0.50 0.00 1</ambient>
      <diffuse>1.00 0.55 0.00 1</diffuse>
      <specular>0.35 0.22 0.05 1</specular>
    </material>
  </gazebo>

  <!-- ═══════════════════════════════════════════════════════════════════
       2. TOP LID — charcoal overhanging plate
       ═══════════════════════════════════════════════════════════════════ -->
  <xacro:visual_link name="lid_link"/>
  <xacro:fixed_joint name="lid_jnt" parent="base_link" child="lid_link"
                     ox="0" oy="0" oz="0.258"/>
  <link name="${robot_ns}/lid_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.920 0.670 0.026"/></geometry>
    </visual>
  </link>
  <gazebo reference="${robot_ns}/lid_link">
    <material>
      <ambient>0.14 0.14 0.14 1</ambient>
      <diffuse>0.18 0.18 0.18 1</diffuse>
      <specular>0.12 0.12 0.12 1</specular>
    </material>
  </gazebo>

  <!-- ═══════════════════════════════════════════════════════════════════
       3. FRONT BUMPER — charcoal safety bar + yellow warning stripe
       ═══════════════════════════════════════════════════════════════════ -->
  <xacro:visual_link name="bumper_front_link"/>
  <xacro:fixed_joint name="bumper_front_jnt" parent="base_link" child="bumper_front_link"
                     ox="0.481" oy="0" oz="-0.025"/>
  <link name="${robot_ns}/bumper_front_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.062 0.720 0.260"/></geometry>
    </visual>
    <!-- Warning stripe -->
    <visual>
      <origin xyz="0.002 0 0.090" rpy="0 0 0"/>
      <geometry><box size="0.064 0.722 0.042"/></geometry>
    </visual>
  </link>
  <gazebo reference="${robot_ns}/bumper_front_link">
    <material>
      <ambient>0.14 0.14 0.14 1</ambient>
      <diffuse>0.18 0.18 0.18 1</diffuse>
      <specular>0.12 0.12 0.12 1</specular>
    </material>
  </gazebo>

  <!-- ═══════════════════════════════════════════════════════════════════
       4. REAR BUMPER
       ═══════════════════════════════════════════════════════════════════ -->
  <xacro:visual_link name="bumper_rear_link"/>
  <xacro:fixed_joint name="bumper_rear_jnt" parent="base_link" child="bumper_rear_link"
                     ox="-0.481" oy="0" oz="-0.025"/>
  <link name="${robot_ns}/bumper_rear_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.062 0.720 0.260"/></geometry>
    </visual>
    <visual>
      <origin xyz="-0.002 0 0.090" rpy="0 0 0"/>
      <geometry><box size="0.064 0.722 0.042"/></geometry>
    </visual>
  </link>
  <gazebo reference="${robot_ns}/bumper_rear_link">
    <material>
      <ambient>0.14 0.14 0.14 1</ambient>
      <diffuse>0.18 0.18 0.18 1</diffuse>
      <specular>0.12 0.12 0.12 1</specular>
    </material>
  </gazebo>

  <!-- ═══════════════════════════════════════════════════════════════════
       5. SIDE ACCENT STRIPES — thin dark panels each side
       ═══════════════════════════════════════════════════════════════════ -->
  <xacro:visual_link name="accent_left_link"/>
  <xacro:fixed_joint name="accent_left_jnt" parent="base_link" child="accent_left_link"
                     ox="0" oy="0.336" oz="0.045"/>
  <link name="${robot_ns}/accent_left_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.900 0.022 0.400"/></geometry>
    </visual>
  </link>
  <gazebo reference="${robot_ns}/accent_left_link">
    <material>
      <ambient>0.14 0.14 0.14 1</ambient>
      <diffuse>0.18 0.18 0.18 1</diffuse>
      <specular>0.12 0.12 0.12 1</specular>
    </material>
  </gazebo>

  <xacro:visual_link name="accent_right_link"/>
  <xacro:fixed_joint name="accent_right_jnt" parent="base_link" child="accent_right_link"
                     ox="0" oy="-0.336" oz="0.045"/>
  <link name="${robot_ns}/accent_right_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.900 0.022 0.400"/></geometry>
    </visual>
  </link>
  <gazebo reference="${robot_ns}/accent_right_link">
    <material>
      <ambient>0.14 0.14 0.14 1</ambient>
      <diffuse>0.18 0.18 0.18 1</diffuse>
      <specular>0.12 0.12 0.12 1</specular>
    </material>
  </gazebo>

  <!-- ═══════════════════════════════════════════════════════════════════
       6. IDENTIFICATION MAST — orange tapered pole
       ═══════════════════════════════════════════════════════════════════ -->
  <xacro:visual_link name="mast_link"/>
  <xacro:fixed_joint name="mast_jnt" parent="base_link" child="mast_link"
                     ox="0" oy="0" oz="0.721"/>
  <link name="${robot_ns}/mast_link">
    <!-- Lower mast half (thicker) -->
    <visual>
      <origin xyz="0 0 -0.225" rpy="0 0 0"/>
      <geometry><cylinder length="0.450" radius="0.062"/></geometry>
    </visual>
    <!-- Upper mast half (thinner — tapered look) -->
    <visual>
      <origin xyz="0 0  0.225" rpy="0 0 0"/>
      <geometry><cylinder length="0.450" radius="0.048"/></geometry>
    </visual>
  </link>
  <gazebo reference="${robot_ns}/mast_link">
    <material>
      <ambient>0.90 0.50 0.00 1</ambient>
      <diffuse>1.00 0.55 0.00 1</diffuse>
      <specular>0.35 0.22 0.05 1</specular>
    </material>
  </gazebo>

  <!-- ═══════════════════════════════════════════════════════════════════
       7. 360° SENSOR RING — dark grey housing at mid-mast
       ═══════════════════════════════════════════════════════════════════ -->
  <xacro:visual_link name="sensor_ring_link"/>
  <xacro:fixed_joint name="sensor_ring_jnt" parent="base_link" child="sensor_ring_link"
                     ox="0" oy="0" oz="0.721"/>
  <link name="${robot_ns}/sensor_ring_link">
    <!-- Outer housing disc -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder length="0.115" radius="0.145"/></geometry>
    </visual>
    <!-- Blue sensor window band -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder length="0.040" radius="0.152"/></geometry>
    </visual>
  </link>
  <gazebo reference="${robot_ns}/sensor_ring_link">
    <material>
      <ambient>0.28 0.28 0.28 1</ambient>
      <diffuse>0.32 0.32 0.32 1</diffuse>
      <specular>0.18 0.18 0.18 1</specular>
    </material>
  </gazebo>

  <!-- ═══════════════════════════════════════════════════════════════════
       8. SAFETY BEACON — bright blue cylinder + sphere
       ═══════════════════════════════════════════════════════════════════ -->
  <xacro:visual_link name="beacon_link"/>
  <xacro:fixed_joint name="beacon_jnt" parent="base_link" child="beacon_link"
                     ox="0" oy="0" oz="1.281"/>
  <link name="${robot_ns}/beacon_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder length="0.200" radius="0.068"/></geometry>
    </visual>
  </link>
  <gazebo reference="${robot_ns}/beacon_link">
    <material>
      <ambient>0.05 0.25 1.00 1</ambient>
      <diffuse>0.10 0.45 1.00 1</diffuse>
      <specular>0.40 0.60 1.00 1</specular>
      <emissive>0.01 0.04 0.15 1</emissive>
    </material>
  </gazebo>

  <xacro:visual_link name="dome_link"/>
  <xacro:fixed_joint name="dome_jnt" parent="base_link" child="dome_link"
                     ox="0" oy="0" oz="1.471"/>
  <link name="${robot_ns}/dome_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.090"/></geometry>
    </visual>
  </link>
  <gazebo reference="${robot_ns}/dome_link">
    <material>
      <ambient>0.05 0.25 1.00 1</ambient>
      <diffuse>0.10 0.45 1.00 1</diffuse>
      <specular>0.40 0.60 1.00 1</specular>
      <emissive>0.01 0.04 0.15 1</emissive>
    </material>
  </gazebo>

  <!-- ═══════════════════════════════════════════════════════════════════
       9 & 10. DRIVE WHEELS  (left + right)
       ═══════════════════════════════════════════════════════════════════ -->
  <joint name="${robot_ns}/wheel_left_joint" type="continuous">
    <parent link="${robot_ns}/base_link"/>
    <child  link="${robot_ns}/wheel_left_link"/>
    <origin xyz="0 ${wheel_sep_half} ${wheel_offset_z}" rpy="-1.5708 0 0"/>
    <axis   xyz="0 0 1"/>
  </joint>
  <link name="${robot_ns}/wheel_left_link">
    <!-- Tyre -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder length="${wheel_width}" radius="${wheel_radius}"/></geometry>
    </visual>
    <!-- Hub cap -->
    <visual>
      <origin xyz="0 0 0.042" rpy="0 0 0"/>
      <geometry><cylinder length="0.018" radius="0.088"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder length="${wheel_width}" radius="${wheel_radius}"/></geometry>
    </collision>
    <inertial>
      <mass value="0.800"/>
      <inertia ixx="0.00621" iyy="0.00621" izz="0.01156"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <gazebo reference="${robot_ns}/wheel_left_link">
    <material>Gazebo/FlatBlack</material>
  </gazebo>

  <joint name="${robot_ns}/wheel_right_joint" type="continuous">
    <parent link="${robot_ns}/base_link"/>
    <child  link="${robot_ns}/wheel_right_link"/>
    <origin xyz="0 -${wheel_sep_half} ${wheel_offset_z}" rpy="-1.5708 0 0"/>
    <axis   xyz="0 0 1"/>
  </joint>
  <link name="${robot_ns}/wheel_right_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder length="${wheel_width}" radius="${wheel_radius}"/></geometry>
    </visual>
    <visual>
      <origin xyz="0 0 0.042" rpy="0 0 0"/>
      <geometry><cylinder length="0.018" radius="0.088"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder length="${wheel_width}" radius="${wheel_radius}"/></geometry>
    </collision>
    <inertial>
      <mass value="0.800"/>
      <inertia ixx="0.00621" iyy="0.00621" izz="0.01156"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <gazebo reference="${robot_ns}/wheel_right_link">
    <material>Gazebo/FlatBlack</material>
  </gazebo>

  <!-- ═══════════════════════════════════════════════════════════════════
       11 & 12. CASTER BALLS (front + rear)
       ═══════════════════════════════════════════════════════════════════ -->
  <joint name="${robot_ns}/caster_front_joint" type="fixed">
    <parent link="${robot_ns}/base_link"/>
    <child  link="${robot_ns}/caster_front_link"/>
    <origin xyz="${caster_front_x} 0 ${caster_z}" rpy="0 0 0"/>
  </joint>
  <link name="${robot_ns}/caster_front_link">
    <visual><geometry><sphere radius="${caster_radius}"/></geometry></visual>
    <collision><geometry><sphere radius="${caster_radius}"/></geometry></collision>
    <inertial>
      <mass value="0.100"/>
      <inertia ixx="1e-4" iyy="1e-4" izz="1e-4" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <gazebo reference="${robot_ns}/caster_front_link">
    <material>Gazebo/DarkGrey</material>
  </gazebo>

  <joint name="${robot_ns}/caster_rear_joint" type="fixed">
    <parent link="${robot_ns}/base_link"/>
    <child  link="${robot_ns}/caster_rear_link"/>
    <origin xyz="${caster_rear_x} 0 ${caster_z}" rpy="0 0 0"/>
  </joint>
  <link name="${robot_ns}/caster_rear_link">
    <visual><geometry><sphere radius="${caster_radius}"/></geometry></visual>
    <collision><geometry><sphere radius="${caster_radius}"/></geometry></collision>
    <inertial>
      <mass value="0.100"/>
      <inertia ixx="1e-4" iyy="1e-4" izz="1e-4" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <gazebo reference="${robot_ns}/caster_rear_link">
    <material>Gazebo/DarkGrey</material>
  </gazebo>

  <!-- ═══════════════════════════════════════════════════════════════════
       13. LiDAR  (at sensor-ring height — 0.896 m above ground)
       ═══════════════════════════════════════════════════════════════════ -->
  <xacro:if value="$(arg laser_enable)">
    <joint name="${robot_ns}/scan_joint" type="fixed">
      <parent link="${robot_ns}/base_link"/>
      <child  link="${robot_ns}/base_scan"/>
      <origin xyz="0 0 0.721" rpy="0 0 0"/>
    </joint>
    <link name="${robot_ns}/base_scan">
      <inertial>
        <mass value="0.114"/>
        <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>
    <gazebo reference="${robot_ns}/base_scan">
      <sensor type="ray" name="${robot_ns}_lidar">
        <pose>0 0 0 0 0 0</pose>
        <visualize>false</visualize>
        <update_rate>10</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159265</min_angle>
              <max_angle> 3.14159265</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.15</min>
            <max>25.0</max>
            <resolution>0.015</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </ray>
        <plugin name="gazebo_ros_lidar" filename="libgazebo_ros_ray_sensor.so">
          <ros>
            <namespace>/${robot_ns}</namespace>
            <remapping>~/out:=scan</remapping>
          </ros>
          <output_type>sensor_msgs/LaserScan</output_type>
          <frame_name>${robot_ns}/base_scan</frame_name>
        </plugin>
      </sensor>
    </gazebo>
  </xacro:if>

  <!-- ═══════════════════════════════════════════════════════════════════
       14. IMU
       ═══════════════════════════════════════════════════════════════════ -->
  <xacro:if value="$(arg imu_enable)">
    <joint name="${robot_ns}/imu_joint" type="fixed">
      <parent link="${robot_ns}/base_link"/>
      <child  link="${robot_ns}/imu_link"/>
      <origin xyz="0 0 ${body_z}" rpy="0 0 0"/>
    </joint>
    <link name="${robot_ns}/imu_link">
      <inertial>
        <mass value="0.001"/>
        <inertia ixx="1e-9" iyy="1e-9" izz="1e-9" ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>
  </xacro:if>

  <!-- ═══════════════════════════════════════════════════════════════════
       DIFFERENTIAL DRIVE PLUGIN
       80 Nm / 40 rad/s²: smooth 0→3.5 m/s in ~0.5 s, no tipping at 60 kg
       ═══════════════════════════════════════════════════════════════════ -->
  <gazebo>
    <plugin name="${robot_ns}_diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <namespace>/${robot_ns}</namespace>
      </ros>
      <left_joint>${robot_ns}/wheel_left_joint</left_joint>
      <right_joint>${robot_ns}/wheel_right_joint</right_joint>
      <wheel_separation>0.580</wheel_separation>
      <wheel_diameter>0.340</wheel_diameter>
      <max_wheel_torque>80</max_wheel_torque>
      <max_wheel_acceleration>40.0</max_wheel_acceleration>
      <command_topic>cmd_vel</command_topic>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>true</publish_wheel_tf>
      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>${robot_ns}/base_footprint</robot_base_frame>
    </plugin>
  </gazebo>

</robot>
